From 386f3dcea18cb2362fc5444dac7e65abf621434b Mon Sep 17 00:00:00 2001
From: Rajat Agarwal <raajat.agarwal@gmail.com>
Date: Fri, 7 Aug 2026 09:53:43 +0000
Subject: [PATCH] ci: wire architecture-doc-drift + module-doc-index-check +
 configuration-doc-coverage jobs into ci.yml [UNPUSHED -- needs workflow
 scope]

Three CI jobs, all non-blocking-warn or check-mode as documented in their
own comments:
- architecture-doc-drift: runs scripts/check-architecture-doc-drift.mjs
- module-doc-index-check: runs scripts/generate-module-doc-index.mjs --check
- configuration-doc-coverage: runs scripts/check-configuration-doc-coverage.mjs

This session's gh token lacks the 'workflow' OAuth scope, so this commit
cannot be pushed from here -- see PROGRESS.md and
ai-os/registry/PENDING-CI-WIRING-architecture-doc-drift.patch for the
exact diff the owner (or a session with workflow scope) needs to apply
and push.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
---
 .github/workflows/ci.yml | 45 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 45 insertions(+)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 93dbecc1c..a7e3c7361 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -98,6 +98,51 @@ jobs:
       # script's own header for the honest limitation this does and
       # doesn't guarantee.
       - run: node scripts/check-metadata-index-coverage.mjs
+  architecture-doc-drift:
+    name: Architecture/Database Doc Drift Check
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v7
+      - uses: oven-sh/setup-bun@v2
+      - run: bun install --frozen-lockfile
+      # AI Documentation gap-closure, 2026-08-07 (UMR-20260801-170930-2080
+      # sub-task): closes the [Low] "AI-Readable Architecture Documentation"
+      # and [Low] "AI-Readable Database Documentation" findings -- both
+      # share one root cause, ai-os/system-tree/ being a manual, point-in-
+      # time snapshot with no signal a re-sync is due. Warns (does not fail
+      # the build, matching Low severity) once live route/table/enum counts
+      # drift more than 10% from ai-os/system-tree/DRIFT-BASELINE.yaml. See
+      # the script's own header for the honest limitation this does and
+      # doesn't guarantee.
+      - run: node scripts/check-architecture-doc-drift.mjs
+  module-doc-index-check:
+    name: Module Doc Index Check
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v7
+      - uses: oven-sh/setup-bun@v2
+      - run: bun install --frozen-lockfile
+      # AI Documentation gap-closure, 2026-08-07 (UMR-20260801-170930-2080
+      # sub-task): closes [Low] "AI-Readable Module Documentation" -- fails
+      # the build if docs/master/MODULE_DOC_INDEX.md is out of sync with
+      # the real leading doc comments in src/lib/services/ (new/renamed
+      # file, or a changed leading comment, without regenerating the
+      # index). See the script's own header for the honest limitation this
+      # does and doesn't guarantee.
+      - run: node scripts/generate-module-doc-index.mjs --check
+  configuration-doc-coverage:
+    name: Configuration Doc Coverage Check
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v7
+      - uses: oven-sh/setup-bun@v2
+      - run: bun install --frozen-lockfile
+      # AI Documentation gap-closure, 2026-08-07 (UMR-20260801-170930-2080
+      # sub-task): closes [Medium] "AI-Readable Configuration Documentation"
+      # -- fails the build if a process.env.X reference in src/ has no
+      # matching row in docs/master/CONFIGURATION.md. See the script's own
+      # header for the honest limitation this does and doesn't guarantee.
+      - run: node scripts/check-configuration-doc-coverage.mjs
   terminology-guardrail-check:
     name: Terminology Guardrail Check
     runs-on: ubuntu-latest
-- 
2.43.0

