{
  "name": "dpdp-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node scripts/build-sitemap.mjs && node scripts/check-public-surface.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "lint": "eslint .",
    "scan-bundle": "node scripts/scan-bundle.mjs",
    "build:sitemap": "node scripts/build-sitemap.mjs",
    "check:public-surface": "node scripts/check-public-surface.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "bun-types": "^1.4.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0"
  }
}
