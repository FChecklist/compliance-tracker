# Copy to .env.local (gitignored) and fill in from Supabase -> Project Settings -> API.
# Only the ANON (publishable) key ever belongs here. The service-role key must
# never be referenced by this app: everything in dist/ ships to every browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Set to 1 to run without any Supabase credentials: an in-memory fixture org
# stands in for the real RPCs (see src/lib/mock-client.ts).
# VITE_MOCK=1
