{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,route,loading,error,not-found,global-error,default,template}.{ts,tsx}",
    "src/middleware.ts",
    "src/db/seed.ts",
    "scripts/**/*.mjs"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "src/components/ui/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "examples/**"
  ],
  "ignoreDependencies": [],
  "ignoreExportsUsedInFile": true
}
