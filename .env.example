# VERIDIAN AI / compliance-tracker -- environment variable reference.
#
# Copy to `.env.local` for local development and fill in real values (never
# commit `.env.local` or any other real `.env*` file -- see .gitignore).
# This file documents WHICH vars exist and WHICH Vercel environment(s) each
# one is expected to be scoped to; it holds no real values, only shape.
#
# Cloud Deployment / Deployment Operations gap-closure (2026-08-07,
# "Environment Configuration Management" finding: no formal dev/staging/prod
# env var separation). Ground truth for how Vercel itself already scopes
# these vars: ai-os/STAGING_ENV_2026-07-20.md (V2-7) -- this file is the
# missing local/dev-facing counterpart to that doc. Per V2-7: this project is
# on Vercel's Hobby plan, which has zero custom environments, so "staging" is
# a long-lived git branch (Vercel auto-builds it as a `preview` deployment),
# not a named Vercel environment; per-var staging scoping uses `gitBranch`
# on the `preview` target (see .github/workflows/sync-vercel-env.yml).

# ── Vercel environment target: which of the 3 real targets a var applies to ─
# production   -> the `main` branch deployment (the live app)
# preview      -> every non-`main` branch, including the long-lived `staging`
#                  branch (see V2-7 doc); `gitBranch=staging` on a var scopes
#                  it to ONLY that branch's previews, not every preview
# development  -> `vercel dev` / this file's own local dev use

# ── Database (production/preview/development -- separate Supabase project or
#    branch per environment is the correct target end-state; a shared
#    project across all three is a real, disclosed interim state, not this
#    file's claim about what SHOULD be true) ────────────────────────────────
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
# Only needed if the runtime pool differs from the migration/admin pool above
# (see src/lib/db/connection-string.ts) -- otherwise falls back to DATABASE_URL.
APP_RUNTIME_DATABASE_URL=

# ── Supabase Auth (production/preview/development) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cron / internal-route auth (production only -- internal /api/internal/**
#    routes and Vercel's own vercel.json crons authenticate with this; a
#    preview/dev value is fine to differ, but every environment that runs a
#    cron route needs SOME value or that route fails closed -- see
#    src/app/api/internal/secrets-audit/run/route.ts) ───────────────────────
CRON_SECRET=

# ── AI providers (production/preview/development -- see
#    src/lib/orchestra-model-resolver.ts / src/lib/llm-client.ts) ───────────
ANTHROPIC_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
ZAI_API_KEY=

# ── Per-org AI config encryption (production/preview/development -- a BYO
#    API key stored per-org is encrypted at rest with this key; losing it or
#    letting it differ between the environment that encrypted a value and
#    the one reading it back makes that stored key permanently undecryptable) ─
AI_CONFIG_ENCRYPTION_KEY=

# ── Observability (production primarily; safe to set for preview/dev too --
#    see sentry.server.config.ts / sentry.edge.config.ts / instrumentation-
#    client.ts, all no-op until this is set) ────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Inbound Vercel deployment webhook (production only -- verifies the
#    x-vercel-signature header on POST /api/webhooks/vercel-deployment; the
#    route fails closed with 500 if unset, so every delivery is rejected
#    until this is provisioned) ─────────────────────────────────────────────
VERCEL_DEPLOYMENT_WEBHOOK_SECRET=
# Optional -- which organisations row to attribute a deployment's audit
# trigger to (a Vercel deployment belongs to the whole platform, not one
# tenant org). Falls back to the earliest-created org if unset.
PLATFORM_AUDIT_ORG_ID=

# ── AI Dev Team dispatch (production only -- repository_dispatch auth,
#    see src/lib/ai-team/*) ──────────────────────────────────────────────────
AI_TEAM_LOG_SECRET=
PAT_FCHECKLIST=

# ── Runtime toggle (set automatically by Vercel/Next.js per environment --
#    do not set by hand; NODE_ENV=development is what Sentry's own sample-
#    rate tuning keys off, see sentry.server.config.ts) ─────────────────────
# NODE_ENV=development
